# Proyecto Keyoku - Variables de Entorno
# Copiar este archivo como .env y completar los valores

# ── Aplicación ──
APP_NAME=Proyecto Keyoku
APP_ENV=development
DEBUG=true
SECRET_KEY=cambiar-por-una-clave-segura-en-produccion

# ── Base de Datos ──
DATABASE_URL=sqlite+aiosqlite:///./kantan.db

# ── JWT ──
JWT_SECRET_KEY=cambiar-por-otra-clave-segura
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Gemini API ──
GEMINI_API_KEY=tu-api-key-de-gemini
GEMINI_MODEL=gemini-3.8-flash

# ── ChromaDB ──
CHROMA_PERSIST_DIR=./chroma_data

# ── Archivos ──
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_UPLOAD_SIZE_MB=20

# ── Embeddings ──
EMBEDDING_MODEL=text-embedding-004
CHUNK_SIZE=800
CHUNK_OVERLAP=100
